{
  "name": "scg-shop-erp",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:server": "pnpm --filter @erp/server dev",
    "dev:web": "pnpm --filter @erp/web dev",
    "db:migrate": "pnpm --filter @erp/db migrate",
    "db:seed": "pnpm --filter @erp/db seed",
    "check:onprem": "node scripts/check-onprem.mjs",
    "e2e": "node e2e/run.mjs",
    "vercel-build": "node scripts/vercel-build.mjs",
    "vercel:local": "node scripts/vercel-local.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild"
    ]
  }
}
