{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scgshop-erp.example/integrations/common/defs.schema.json",
  "title": "Common definitions",
  "$defs": {
    "decimal": {
      "type": "string",
      "pattern": "^-?\\d+(\\.\\d+)?$",
      "description": "Decimal string (no JSON numbers for money/qty)"
    },
    "decimalNonNegative": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d+)?$",
      "description": "Non-negative decimal string"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 with offset"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "vat": {
      "type": "string",
      "enum": [
        "v7",
        "exempt"
      ]
    },
    "currency": {
      "type": "string",
      "const": "THB"
    }
  }
}
